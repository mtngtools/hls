# E2E Test Configuration
# Copy this to .env.test.e2e.local and configure for your local testing

# Enable/disable E2E tests
AWS_S3_E2E_ENABLED=false

# Source HLS stream to test against
TEST_HLS_URL=https://test-streams.mux.dev/x36xhzz/x36xhzz.m3u8

# AWS S3 Configuration for E2E tests
TEST_S3_BUCKET=your-test-bucket-name-here
TEST_S3_PREFIX=test-hls-e2e-
TEST_S3_PATH=my-transfer/output.m3u8

STATUS_BUCKET=your-test-bucket-name-here
STATUS_PREFIX=test-hls-e2e-status-
STATUS_PATH=my-transfer-status
