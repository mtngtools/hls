# E2E Test Configuration
# Copy this to .env.test.e2e.local and configure for your local testing

# Enable/disable E2E tests
AWS_S3_E2E_ENABLED=false

# Source HLS stream to test against
TEST_HLS_URL=https://

# AWS S3 Configuration for E2E tests
TEST_S3_BUCKET=your-test-bucket-name-here
TEST_S3_PREFIX=test-hls-e2e-
TEST_S3_PATH=my-transfer/h
TEST_S3_M3U8_NAME=index.m3u8
TEST_S3_MAKE_PUBLIC=false

TEST_STATUS_BUCKET=your-test-bucket-name-here
TEST_STATUS_PREFIX=test-hls-e2e-status-
TEST_STATUS_PATH=my-transfer-status

# AWS Credentials
# Uncomment and set these if you don't have AWS CLI configured natively:
# AWS_ACCESS_KEY_ID=your_access_key_id_here
# AWS_SECRET_ACCESS_KEY=your_secret_access_key_here
# AWS_REGION=us-east-1

