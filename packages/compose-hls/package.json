{
    "name": "@mtngtools/compose-hls",
    "version": "0.0.1-experimental.4",
    "description": "Composed HLS core orchestrator with AWS S3 support",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "example:advanced-s3": "tsx examples/advanced-s3.ts",
        "build": "vite build",
        "dev": "vite build --watch",
        "clean": "rimraf dist",
        "typecheck": "tsc --noEmit",
        "lint": "oxlint",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:verbose": "vitest run --reporter=verbose",
        "test:ui": "vitest --ui",
        "test:min": "vitest run --reporter=dot",
        "test:e2e": "vitest run --config vitest.e2e.config.ts",
        "test:e2e:verbose": "vitest run --config vitest.e2e.config.ts --reporter=verbose",
        "test:e2e:ui": "vitest --ui --config vitest.e2e.config.ts",
        "test:all": "pnpm run test && pnpm run test:e2e",
        "test:coverage": "vitest run --coverage",
        "test:typecheck": "tsc -p tsconfig.test.json",
        "publish:experimental": "pnpm publish --tag experimental --access public"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.600.0",
        "@mtngtools/frame-hls-base": "workspace:*",
        "@mtngtools/provide-hls-aws": "workspace:*",
        "@mtngtools/utils-hls-types": "workspace:*"
    },
    "devDependencies": {
        "@mtngtools/utils-hls-core": "workspace:*",
        "@types/node": "^22.0.0",
        "@vitest/ui": "2.1.9"
    },
    "keywords": [
        "hls",
        "aws",
        "s3",
        "orchestrator",
        "compose"
    ],
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    }
}