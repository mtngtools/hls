{
    "name": "@mtngtools/frame-hls-base",
    "version": "0.0.1-experimental.3",
    "description": "Default HLS client implementation (Core + Transfer)",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "vite build",
        "dev": "vite build --watch",
        "clean": "rimraf dist",
        "typecheck": "tsc --noEmit",
        "lint": "oxlint",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "E2E_ENABLED=true vitest run",
        "test:typecheck": "tsc -p tsconfig.test.json",
        "publish:experimental": "pnpm publish --tag experimental --access public"
    },
    "dependencies": {
        "@mtngtools/utils-hls-core": "workspace:*",
        "@mtngtools/frame-hls-transfer": "workspace:*",
        "@mtngtools/utils-hls-types": "workspace:*",
        "@mtngtools/utils-hls-parser": "workspace:*"
    },
    "keywords": [
        "hls",
        "client",
        "default"
    ],
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    },
    "devDependencies": {
        "@types/node": "^25.1.0"
    }
}
